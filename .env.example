# Password for /command-center (required to enable it)
COMMAND_CENTER_PASSWORD=
# Optional: keeps admin sessions valid across server restarts
COMMAND_CENTER_SECRET=

# Neon Postgres (pooled connection string). Added automatically by the Vercel Neon integration
DATABASE_URL=

# Email (SMTP) for SHARE: the two PDFs are sent to the recipients set in the command center.
# For Gmail, create an App Password (Google account > Security > 2-Step Verification > App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional: the From address (defaults to SMTP_USER)
SMTP_FROM=
