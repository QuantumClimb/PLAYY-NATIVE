# Password for /command-center (required to enable it)
COMMAND_CENTER_PASSWORD=
# Optional: keeps admin sessions valid across server restarts
COMMAND_CENTER_SECRET=

# Neon Postgres (pooled connection string). Added automatically by the Vercel Neon integration
DATABASE_URL=

# Email (SMTP) for SHARE: the two PDFs are sent to the recipients set in the command center.
# For Gmail, create an App Password (Google account > Security > 2-Step Verification > App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional: the From address (defaults to SMTP_USER)
SMTP_FROM=

# WhatsApp through Qikberry (https://apidocs.qikberry.ai). The token, the business's own WhatsApp number
# (digits, e.g. 919876543210) and an approved template with a PDF header are all needed; SITE_URL must be public.
WHATSAPP_SENDER_NUMBER=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
# document = the template has a PDF header; text = the name is in the header; none = nothing in the header (no PDF is sent on WhatsApp)
WHATSAPP_TEMPLATE_HEADER=document
# What fills the template's {{1}}, {{2}}: name, card (link to the trump card PDF). Leave empty for none.
WHATSAPP_TEMPLATE_BODY=name
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v22.0

# Public address of the site (for link previews). On Vercel it is found automatically.
SITE_URL=
