{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite build && node server/kiosk-server.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "server": "node server/kiosk-server.mjs",
    "printer-helper": "node server/kiosk-server.mjs",
    "clean": "rm -rf dist server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dead-code": "knip",
    "test": "vitest run",
    "test:e2e": "playwright test --grep-invert \"every kiosk page\"",
    "test:visual": "playwright test visual",
    "test:visual:update": "playwright test visual --update-snapshots",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run dead-code && npm test"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "express": "^4.21.2",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "nodemailer": "^10.1.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "dotenv": "^18.0.7",
    "esbuild": "^0.25.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.1",
    "knip": "^6.41.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.2.3",
    "vitest": "^5.0.3"
  }
}
